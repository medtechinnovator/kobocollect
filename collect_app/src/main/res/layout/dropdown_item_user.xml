<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_standard"
    android:paddingVertical="@dimen/margin_extra_small"
    android:minHeight="48dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/user_dropdown_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?textAppearanceBody1"
        android:textColor="?colorOnSurface"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Jane Smith" />

    <TextView
        android:id="@+id/user_dropdown_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?textAppearanceBody2"
        android:textColor="?colorOnSurfaceVariant"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="janedoe" />

    <TextView
        android:id="@+id/user_dropdown_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="?textAppearanceBody2"
        android:textColor="?colorOnSurfaceVariant"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="jane@example.com" />
</LinearLayout>
